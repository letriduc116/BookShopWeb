@model CoverType

<form asp-action="Edit" method="post">
    <div class="border p-3">
        <div class="row pb-2">
            <h2>edit CoverType</h2>
            <hr />
        </div>
        @*
        <div asp-validation-summary="All"></div>
        asp-validation : hiển thị thông báo lỗi
        *@
        <div class="mb-3">
            <label asp-for=Name>name</label>
            <input asp-for=Name class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        
        <button type="submit" class="btn btn-primary">Update</button>

        @*asp-controller="category" asp-action="Index" : tạo link đến action Index của controller category*@
        <a asp-controller="CoverType" asp-action="Index" class="btn btn-primary">Back To List</a>
    </div>
</form>


@*@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}*@
