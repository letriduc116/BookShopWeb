@model IEnumerable<BanSach.Model.Product> //name space of Product in BanSach.Model namespace
@* @model IEnumerable<Product>  gọi kiểu này cũng được luôn !? *@ 


<div class="row pd-3">
    @foreach (var item in Model) 
    {
        <div class="col-lg-3 col-md-6">
            <div class="row p-2">
                <div class="col-12 p-1" style="border: 1px solid #008cba; border-radius: 5px">
                    <div class="card">
                        <img src="@item.ImageUrl" style="width: 303px; height: 303px; object-fit: cover" />
                        <div class="card-body">
                            <div class="pl-1">
                                <p class="card-title h5 text-primary">@item.Title</p>
                                <p class="card-title h5 text-info">by <b>@item.Author</b> </p>
                            </div>

                            <div class="pl-1">
                                <p>ListPrice: <strike>@item.Price50.ToString("$0.00")</strike></p>
                            </div>
                            <div class="pl-1">
                                <p>As Low as: @item.Price100.ToString("$0.00")</p>
                            </div>
                        </div>
                    </div>
                    <div>
                        <a asp-action="Details" class="btn btn-primary form-control" asp-route-id="@item.Id">Detail</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

